# Keep the build context small, and keep local state out of the image: the
# database in ./data belongs to whoever ran the portal on this laptop.
.git/
__pycache__/
**/__pycache__/
*.py[cod]
data/
data-test/
tmp/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Not needed at runtime.
spec.md
README.md
acceptance-report.txt
Dockerfile
docker-compose.yml
docker-compose.offline.yml
.dockerignore

# Nothing above may exclude app/, tests/, fixtures.json, run.py or .dogfood.toml:
# the Dockerfile COPYs all five into the image, and a hosted builder (Render)
# builds from a plain clone of the repository, so an untracked file is not in the
# context at all. `git ls-files .dogfood.toml run.py fixtures.json` is the check.
